# =============================================================================
# Vercel environment variables — OVATO.ai by Talent Socio
# Copy each key into Vercel → Project → Settings → Environment Variables
# Apply to: Production + Preview
# =============================================================================

# -----------------------------------------------------------------------------
# CHECKLIST vs your old Vercel screenshot (24 keys)
# -----------------------------------------------------------------------------
# ✓ AIRTABLE_JOB_CLAIMS_TABLE
# ✓ JOB_CLAIM_RECLAIM_HOURS
# ✓ NEXT_PUBLIC_APP_URL
# ✓ APP_URL
# ✓ NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# ✓ CLERK_SECRET_KEY
# ✓ NEXT_PUBLIC_CLERK_SIGN_IN_URL
# ✓ NEXT_PUBLIC_CLERK_SIGN_UP_URL
# ✓ NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL
# ✓ NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL
# ✓ AIRTABLE_API_KEY
# ✓ AIRTABLE_BASE_ID
# ✓ AIRTABLE_COMPAT_MODE
# ✓ AIRTABLE_ALLOCATIONS_MODE
# ✓ AIRTABLE_SUBMISSIONS_MODE
# ✓ AIRTABLE_CLIENTS_TABLE
# ✓ AIRTABLE_JOBS_TABLE
# ✓ AIRTABLE_PARTNERS_TABLE
# ✓ AIRTABLE_CANDIDATES_TABLE
# ✓ AIRTABLE_ACCOUNT_MANAGERS_TABLE
# ✓ AIRTABLE_SUPER_ADMIN_EMAILS
# ✓ AIRTABLE_ADMIN_EMAILS
# ✓ UPLOAD_PROVIDER
# ✓ EMAIL_PROVIDER
#
# ADD these on the new Vercel account (missing from screenshot):
# + RESEND_API_KEY
# + EMAIL_FROM
# + AIRTABLE_PARTNER_QUERIES_TABLE
# + FEEDBACK_TO_EMAIL
# + FEEDBACK_CC_EMAILS
# + CRON_SECRET
#
# Optional (leave blank on locked client base):
#   AIRTABLE_USERS_TABLE, AIRTABLE_ALLOCATIONS_TABLE, AIRTABLE_SUBMISSIONS_TABLE,
#   AIRTABLE_DOCUMENTS_TABLE, AIRTABLE_PAYOUTS_TABLE, AIRTABLE_ACTIVITIES_TABLE,
#   AIRTABLE_NOTIFICATIONS_TABLE, AIRTABLE_NOTIFICATION_PREFERENCES_TABLE,
#   AIRTABLE_SETTINGS_TABLE

# -----------------------------------------------------------------------------
# App URL (no trailing slash) — set after first deploy
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
APP_URL=https://your-app.vercel.app

# -----------------------------------------------------------------------------
# Clerk — https://dashboard.clerk.com → API Keys
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/callback
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/sign-in

# -----------------------------------------------------------------------------
# Airtable
# -----------------------------------------------------------------------------
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_COMPAT_MODE=client
AIRTABLE_ALLOCATIONS_MODE=job_partners
AIRTABLE_SUBMISSIONS_MODE=candidates
AIRTABLE_CLIENTS_TABLE=Clients
AIRTABLE_JOBS_TABLE=Jobs
AIRTABLE_PARTNERS_TABLE=Partners
AIRTABLE_CANDIDATES_TABLE=Candidates
AIRTABLE_ACCOUNT_MANAGERS_TABLE=Account Managers
AIRTABLE_JOB_CLAIMS_TABLE=Job Claims
AIRTABLE_PARTNER_QUERIES_TABLE=Partner Queries
JOB_CLAIM_RECLAIM_HOURS=48
AIRTABLE_SUPER_ADMIN_EMAILS=superadmin@yourcompany.com
AIRTABLE_ADMIN_EMAILS=admin@yourcompany.com
AIRTABLE_USERS_TABLE=
AIRTABLE_ALLOCATIONS_TABLE=
AIRTABLE_SUBMISSIONS_TABLE=
AIRTABLE_DOCUMENTS_TABLE=
AIRTABLE_PAYOUTS_TABLE=
AIRTABLE_ACTIVITIES_TABLE=
AIRTABLE_NOTIFICATIONS_TABLE=
AIRTABLE_NOTIFICATION_PREFERENCES_TABLE=
AIRTABLE_SETTINGS_TABLE=

# -----------------------------------------------------------------------------
# Providers
# -----------------------------------------------------------------------------
UPLOAD_PROVIDER=airtable

# -----------------------------------------------------------------------------
# Email & communications
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="OVATO.ai <noreply@yourdomain.com>"
FEEDBACK_TO_EMAIL=sonu@yourcompany.com
FEEDBACK_CC_EMAILS=vinit@talentsocio.com
CRON_SECRET=generate-a-long-random-string

# Vercel sets these automatically — do not add manually:
# VERCEL_ENV, VERCEL_GIT_COMMIT_SHA
