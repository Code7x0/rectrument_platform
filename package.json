{
  "name": "recruiting-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "migrate:business-ids": "node --env-file=.env.local scripts/migrate-business-ids.mjs",
    "migrate:business-ids:dry": "DRY_RUN=1 node --env-file=.env.local scripts/migrate-business-ids.mjs",
    "backfill:job-ids": "node --env-file=.env.local scripts/backfill-job-ids-from-markers.mjs",
    "backfill:job-ids:dry": "DRY_RUN=1 node --env-file=.env.local scripts/backfill-job-ids-from-markers.mjs",
    "am:upsert": "node --env-file=.env.local scripts/upsert-account-manager.mjs",
    "test:roles": "node --env-file=.env.local scripts/verify-role-identity.mjs",
    "test:file-preview": "tsx --test lib/files/build-file-response.test.ts lib/files/resolve-client-preview.test.ts",
    "test:unit": "tsx --test features/jobs/services/jobs.mapper.client.test.ts features/jobs/lib/job-priority-sort.test.ts features/submissions/lib/submission-status-buckets.test.ts features/submissions/lib/duplicate-candidate-policy.test.ts features/job-claims/services/job-claims.service.test.ts features/job-claims/lib/claim-markers.test.ts features/job-claims/lib/reclaim.test.ts features/jobs/services/jobs-am-visibility.test.ts lib/files/build-file-response.test.ts lib/files/resolve-client-preview.test.ts features/users/lib/partner-registration.test.ts lib/airtable/format-percent.test.ts features/partner-documents/lib/document-slots.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.18",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "airtable": "^0.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "next": "15.5.20",
    "pdfjs-dist": "^4.10.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.81.0",
    "resend": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
